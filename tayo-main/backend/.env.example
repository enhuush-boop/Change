# Copy to backend/.env and edit. Everything is optional except the models.
# The backend runs fully locally with the defaults below.

# --- Models ---------------------------------------------------------------
# Smaug is a 2026 detector with Nano Banana / Imagen-era coverage (~870 MB).
# If it cannot load, the smaller Ateeqq model is used automatically.
#
# Revisions pin the exact weights used for the published evaluation, so a fresh
# clone downloads identical files instead of following each model's main branch.
# If you change a model ID, set its revision too (or leave it empty to use main).
IMAGE_MODEL_PRIMARY=abacusai/Smaug-AI-Image-Detector
IMAGE_MODEL_PRIMARY_REVISION=c7c95951e04a87b884a4ad479401b1128c3903bd
IMAGE_MODEL_FALLBACK=Ateeqq/ai-vs-human-image-detector
IMAGE_MODEL_FALLBACK_REVISION=60e82406916921b823616bee33397baab38af3f0
IMAGE_MODEL_SECONDARY=umm-maybe/AI-image-detector
IMAGE_MODEL_SECONDARY_REVISION=c7e223baf11bc40528af364ba7bdea030ef42f9e
# Secondary model is art-focused, old, and license-ambiguous. Off by default.
ENABLE_SECONDARY_IMAGE_MODEL=0
# Smaug crops: 1 = centre crop (about 3x faster), 3 = start/centre/end (slower).
SMAUG_CROPS=1
# Optional local snapshot directory, e.g. /models/smaug, for offline use.
# SMAUG_MODEL_PATH=
TEXT_MODEL_ID=rasbt/ai-text-detector-modernbert
TEXT_MODEL_REVISION=a6efd4bf6ecd852f332b2569ae0f98cae13b7985
ENABLE_TEXT_MODEL=1
# auto | cpu | cuda
DEVICE=auto
# MODEL_CACHE_DIR=./.model_cache

# --- Optional local LLM (summary rewriting only) ---------------------------
# Install Ollama, run `ollama pull qwen3:4b`, then:
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b

# --- Optional hosted services ----------------------------------------------
# Google Fact Check Tools API key (broader claim coverage):
# GOOGLE_FACTCHECK_API_KEY=
# Google Safe Browsing key (URL threat intel):
# GOOGLE_SAFE_BROWSING_API_KEY=
# VirusTotal API key (submits URLs for fresh scans; submissions may be public):
# VIRUSTOTAL_API_KEY=
# abuse.ch URLhaus Auth-Key:
# URLHAUS_AUTH_KEY=

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_MB=100
MAX_IMAGE_URL_MB=20
REQUEST_TIMEOUT=15
MAX_WEBPAGE_MB=3
MAX_PREVIEW_IMAGE_MB=2
VIDEO_FRAMES=8

# CORS. "*" is for local development only.
ALLOWED_ORIGINS=*
